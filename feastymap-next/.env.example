# Public, keyless development providers. Endpoints are configurable; public services
# are best-effort and subject to fair-use limits, throttling, and change.
PHOTON_API_URL=https://photon.komoot.io/api
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_DRIVING_URL=https://router.project-osrm.org/route/v1/driving
OSRM_WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving
OSRM_BICYCLING_URL=https://routing.openstreetmap.de/routed-bike/route/v1/driving
PUBLIC_PROVIDER_USER_AGENT=FeastyMapNext/1.0 (Pondicherry outing planner)

# Open-Meteo forecast endpoint
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Interactive map; default uses the standard OpenStreetMap tile service.
# Keep visible attribution and follow its tile usage policy; do not bulk-download.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>

# Database configuration (backend only; never prefix with NEXT_PUBLIC_)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/feastymap

# Frontend to FastAPI and CORS allowlist
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4028

# Pondicherry provisional search circle (not an official city boundary)
PONDICHERRY_SEARCH_RADIUS_METERS=10000
